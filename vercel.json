{
  "version":2,
  "builds": [
  {"src": "server.js", "use": "@vercel/node" },
  {"src": "style.css", "use": "@vercel/static"},
  {"src": "assets/**", "use": "@vercel/static"},
  {"src": "index.html", "use": "@vercel/static"},
  ],
  "routes":[
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    },
}
